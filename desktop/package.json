{
  "name": "artema-portal",
  "productName": "Artema Portal",
  "version": "1.0.5",
  "description": "Send and receive shop files between the offices and the CNC machines.",
  "author": "Artema Door",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/e2e.js && node scripts/e2e-cert.js && node scripts/e2e-edition.js && node scripts/e2e-roles.js && node scripts/e2e-update.js && node scripts/e2e-selfupdate.js && node scripts/e2e-orders.js",
    "dist": "node scripts/dist.js all",
    "dist:server": "node scripts/dist.js server",
    "dist:client": "node scripts/dist.js client",
    "publish": "node scripts/publish.js"
  },
  "build": {
    "appId": "com.artema.portal",
    "productName": "Artema Portal",
    "artifactName": "Artema-Portal-${version}-win.zip",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "src/**/*",
      "web/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "selfsigned": "^5.5.0",
    "xlsx": "^0.18.5"
  }
}
